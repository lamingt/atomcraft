---
import { Image } from "astro:assets";
import Default from "../../assets/roles/default.svg";

export interface Props {
  imageSrc: ImageMetadata;
  imageAlt: string;
  name: string;
  role: string;
  imageSize?: string;
}

const { imageSrc, imageAlt, name, role, imageSize = "" } = Astro.props;
---

<div class="flex w-full flex-col items-center">
  <Image
    src={imageSrc || Default}
    alt={imageAlt || "Team member"}
    class="aspect-square w-full max-w-50 rounded-full object-cover md:max-w-80"
  />
  <div class="mt-3 w-full md:mt-4">
    <p
      class="text-center text-lg font-medium wrap-break-word md:text-xl xl:text-2xl"
    >
      {name}
    </p>
    <p class="text-center text-sm wrap-break-word md:text-base">
      {role}
    </p>
  </div>
</div>
