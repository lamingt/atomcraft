---
import { Image } from "astro:assets";
import { type Member } from "../../content/config";
import RolesCard from "./RolesCard.astro";

export interface Props {
  teamName: string;
  description: string;
  members: Member[];
  memberImageLookup: Record<string, ImageMetadata>;
}
const { teamName, description, members, memberImageLookup } = Astro.props;
const gridCols =
  teamName == "Academics"
    ? "grid-cols-2 md:mt-5 lg:grid-cols-3"
    : "grid-cols-2 md:grid-cols-3 lg:grid-cols-4";
---

<section>
  <div class="flex flex-row">
    <div class="mr-10 w-[330px] shrink-0">
      <h2 class="mr-9 mb-9 text-[36px] leading-[120%]">{teamName}</h2>
      {description && <p>{description}</p>}
    </div>

    <div class="min-w-0 flex-1">
      <div
        class={`mt-10 grid w-full justify-items-center gap-10 md:mt-5 ${gridCols}`}
      >
        {
          members.map((member) => (
            <RolesCard imageSrc={memberImageLookup[member.id]} {...member} />
          ))
        }
      </div>
    </div>
  </div>
</section>
