---
import { type Member } from "../../content/config";
import RolesCard from "./RolesCard.astro";

export interface Props {
  teamName: string;
  description: string;
  members: Member[];
  memberImageLookup: Record<string, ImageMetadata>;
}

const { teamName, description, members, memberImageLookup } = Astro.props;

const gridCols =
  members.length === 1
    ? "grid-cols-1 md:grid-cols-2 xl:grid-cols-3"
    : teamName == "Academics"
      ? "grid-cols-1 xs:grid-cols-2 xl:grid-cols-3"
      : "grid-cols-1 xs:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4";
---

<section>
  <div class="flex flex-col items-center md:flex-row md:items-start">
    <div
      class="mb-8 w-full shrink-0 text-center md:mr-10 md:mb-0 md:w-[280px] md:text-start lg:w-[300px] xl:w-[330px]"
    >
      <h2 class="mb-4 text-3xl leading-[120%] md:mb-9 lg:mr-9 lg:text-[36px]">
        {teamName}
      </h2>
      {description && <p>{description}</p>}
    </div>

    <div class="w-full min-w-0 flex-1 md:w-auto">
      <div
        class={`grid w-full justify-items-center gap-6 md:gap-10 ${gridCols}`}
      >
        {
          members.map((member) => (
            <RolesCard imageSrc={memberImageLookup[member.id]} {...member} />
          ))
        }
      </div>
    </div>
  </div>
</section>
