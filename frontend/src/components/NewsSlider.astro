---
import { getCollection } from "astro:content";
import SecondaryOutlineButton from "./buttons/SecondaryOutlineButton.astro";
import RegularNewsCard from "./RegularNewsCard.astro";
import type { ImageMetadata } from "astro";
import rightArrow from "../assets/right-arrow.svg";
import leftArrow from "../assets/left-arrow.svg";
import { Image } from "astro:assets";

const news = await getCollection("news");
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/notion-images/news/*.{jpeg,jpg,png,svg,webp}",
);
const imageLookup: Record<string, ImageMetadata> = {};

for (const path in images) {
  const file = path.split("/").pop()!;
  const base = file.replace(/\.(jpg|jpeg|png|svg|webp)$/i, "");
  imageLookup[base] = (await images[path]()).default;
}
---

<section class="w-full">
  <div class="mb-6 flex justify-between md:mb-12">
    <h3 class="text-heading-3">News</h3>
    <SecondaryOutlineButton href="/news"> View All </SecondaryOutlineButton>
  </div>
  <div class="flex gap-9 overflow-x-hidden" id="news-slider-container">
    {
      news.map((article) => (
        <RegularNewsCard
          imageSrc={imageLookup[article.id]}
          title={article.data.name}
          imageAlt={article.data.imageAlt}
          tags={article.data.categories}
          description={article.data.description}
          date={article.data.date}
          url={article.data.url}
        />
      ))
    }
  </div>

  <div class="mt-5 flex w-full justify-center gap-8 lg:justify-end">
    <SecondaryOutlineButton
      href="javascript:void(0)"
      class="group z-10"
      id="news-prev-btn"
    >
      <Image
        src={leftArrow}
        alt="left arrow"
        class="py-2 group-hover:invert group-active:invert-0"
      />
    </SecondaryOutlineButton>
    <SecondaryOutlineButton
      href="javascript:void(0)"
      class="group z-10"
      id="news-next-btn"
    >
      <Image
        src={rightArrow}
        alt="left arrow"
        class="py-2 group-hover:invert group-active:invert-0"
      />
    </SecondaryOutlineButton>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { horizontalLoop } from "../helpers";
  import { Observer } from "gsap/Observer";

  gsap.registerPlugin(Observer);

  const parts = gsap.utils.toArray(".regular-news") as HTMLElement[];
  const loop = horizontalLoop(parts, {
    paused: true,
    paddingRight: 36,
  });

  document.querySelector("#news-next-btn")?.addEventListener("click", () => {
    loop.next({
      duration: 0.5,
      ease: "power0.5.out",
    });
  });

  document.querySelector("#news-prev-btn")?.addEventListener("click", () => {
    loop.previous({
      duration: 0.5,
      ease: "power1.out",
    });
  });

  const goNext = () => {
    loop.next({
      duration: 1,
      ease: "power3.inOut",
    });
  };

  const goPrev = () => {
    loop.previous({
      duration: 1,
      ease: "power3.inOut",
    });
  };

  document.querySelector("#next-btn")?.addEventListener("click", goNext);
  document.querySelector("#prev-btn")?.addEventListener("click", goPrev);

  Observer.create({
    type: "touch,pointer",
    target: document.querySelector("#news-slider-container"),
    onLeft: goNext,
    onRight: goPrev,
    tolerance: 100,
    preventDefault: true,
  });
</script>
