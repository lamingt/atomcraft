---
import { getCollection } from "astro:content";
import SecondaryOutlineButton from "./buttons/SecondaryOutlineButton.astro";
import RegularNewsCard from "./RegularNewsCard.astro";
import type { ImageMetadata } from "astro";
import rightArrow from "../assets/right-arrow.svg";
import leftArrow from "../assets/left-arrow.svg";
import { Image } from "astro:assets";

const news = await getCollection("news");
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/notion-images/news/*.{jpeg,jpg,png,svg,webp}",
);
const imageLookup: Record<string, ImageMetadata> = {};

for (const path in images) {
  const file = path.split("/").pop()!;
  const base = file.replace(/\.(jpg|jpeg|png|svg|webp)$/i, "");
  imageLookup[base] = (await images[path]()).default;
}

const clonedNews = Array(6).fill(news).flat();
---

<section class="w-full">
  <div class="mb-6 flex justify-between md:mb-12">
    <h3 class="text-heading-3">News</h3>
    <SecondaryOutlineButton href="/news"> View All </SecondaryOutlineButton>
  </div>
  <div class="flex gap-9 overflow-x-hidden touch-pan-y" id="news-slider-container">
    {
      clonedNews.map((article) => (
        <div class="hs-news-item shrink-0">
          <RegularNewsCard
            imageSrc={imageLookup[article.id]}
            title={article.data.name}
            imageAlt={article.data.imageAlt}
            tags={article.data.categories}
            description={article.data.description}
            date={article.data.date}
            url={article.data.url}
          />
        </div>
      ))
    }
  </div>

  <div class="mt-5 flex w-full justify-center gap-8 lg:justify-end">
    <SecondaryOutlineButton
      href="javascript:void(0)"
      class="group z-10"
      id="news-prev-btn"
    >
      <Image
        src={leftArrow}
        alt="left arrow"
        class="py-2 group-hover:invert group-active:invert-0"
      />
    </SecondaryOutlineButton>
    <SecondaryOutlineButton
      href="javascript:void(0)"
      class="group z-10"
      id="news-next-btn"
    >
      <Image
        src={rightArrow}
        alt="left arrow"
        class="py-2 group-hover:invert group-active:invert-0"
      />
    </SecondaryOutlineButton>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { horizontalLoop } from "../helpers";
  import { Observer } from "gsap/Observer";

  gsap.registerPlugin(Observer);

  document.addEventListener("DOMContentLoaded", () => {
    const newsParts = gsap.utils.toArray(".hs-news-item") as HTMLElement[];
    if (newsParts.length > 0) {
      const newsLoop = horizontalLoop(newsParts, {
        paused: true,
        paddingRight: 36,
      });

      const wrapNewsTime = gsap.utils.wrap(0, newsLoop.duration());
      const itemTimeNews = newsLoop.times[1] - newsLoop.times[0];

      let newsProxy = { time: newsLoop.totalTime() };
      let newsTargetTime = newsLoop.totalTime();

      document.querySelector("#news-next-btn")?.addEventListener("click", () => {
        if (!gsap.isTweening(newsProxy)) {
           newsProxy.time = newsLoop.totalTime();
           newsTargetTime = newsProxy.time;
        }
        newsTargetTime += itemTimeNews;
        gsap.to(newsProxy, {
          time: newsTargetTime,
          duration: 0.5,
          ease: "power2.out",
          onUpdate: () => { newsLoop.totalTime(wrapNewsTime(newsProxy.time)); }
        });
      });

      document.querySelector("#news-prev-btn")?.addEventListener("click", () => {
        if (!gsap.isTweening(newsProxy)) {
           newsProxy.time = newsLoop.totalTime();
           newsTargetTime = newsProxy.time;
        }
        newsTargetTime -= itemTimeNews;
        gsap.to(newsProxy, {
          time: newsTargetTime,
          duration: 0.5,
          ease: "power2.out",
          onUpdate: () => { newsLoop.totalTime(wrapNewsTime(newsProxy.time)); }
        });
      });

      Observer.create({
        type: "touch,pointer",
        target: document.querySelector("#news-slider-container"),
        tolerance: 0,
        preventDefault: false, // Managed natively via touch-pan-y css!
        onChangeX: (self) => {
          gsap.killTweensOf(newsProxy);
          let timeDelta = self.deltaX / 100;
          let newTime = newsLoop.totalTime() - timeDelta;
          newsLoop.totalTime(wrapNewsTime(newTime));
        },
        onRelease: (self) => {
          let velocity = self.velocityX / 100;
          if (Math.abs(velocity) > 0.2) {
             newsProxy.time = newsLoop.totalTime();
             gsap.to(newsProxy, {
               time: newsProxy.time - velocity * 0.4,
               duration: 0.6,
               ease: "power2.out",
               onUpdate: () => { newsLoop.totalTime(wrapNewsTime(newsProxy.time)); }
             });
          }
        }
      });
    }
  });
</script>
