---
export type Props = {
  href: string;
  id?: string;
  class?: string;
  blank?: boolean;
};

const { href, id, blank = false } = Astro.props;
---

<a
  href={href}
  id={id}
  target={blank ? "_blank" : undefined}
  class:list={[
    "inline-flex cursor-pointer items-center justify-center rounded-[100px] border-1 border-white bg-transparent px-[25px] py-[10.87px] text-sm duration-200 hover:bg-white hover:text-black active:border-white active:bg-transparent active:text-white active:opacity-60 sm:text-[18px] md:border-2 lg:px-[30px] lg:py-[13px] xl:px-[38px] xl:py-[16.5px] 2xl:border-[3px]",
    Astro.props.class,
  ]}
>
  <slot />
</a>