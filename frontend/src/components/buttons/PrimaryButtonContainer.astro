---
export type Props = {
  id?: string;
  class?: string;
};

const { id, class: extraClass = "" } = Astro.props;
---

<div
  id={id ? id : undefined}
  class:list={[
    "bg-cyan border-cyan inline-flex items-center justify-center rounded-[100px] border-1 px-[25px] py-[10.87px] text-sm text-black sm:text-[18px] md:border-2 lg:px-[30px] lg:py-[13px] xl:px-[38px] xl:py-[16.5px]",
    extraClass,
  ]}
>
  <slot />
</div>
