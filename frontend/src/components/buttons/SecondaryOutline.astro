---
export type Props = {
  id?: string;
  class?: string;
};

const { id } = Astro.props;
---

<div
  id={id}
  class:list={[
    "inline-flex items-center justify-center rounded-[100px] border border-white bg-transparent px-[25px] py-[10.87px] text-sm sm:text-[18px] md:border-2 lg:px-[30px] lg:py-[13px] xl:px-[38px] xl:py-[16.5px] 2xl:border-[3px]",
    Astro.props.class,
  ]}
>
  <slot />
</div>
