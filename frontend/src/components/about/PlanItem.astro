---
interface Props {
  year: string;
  subtitle: string;
  title: string;
  fillPercentage: number;
  items: string[];
}

const { year, subtitle, title, fillPercentage, items } = Astro.props;
---

<div class="flex gap-9">
  <div class="h-[450px] w-1 overflow-hidden rounded-full bg-white/50">
    <div
      class="bg-cyan w-full transition-all duration-300 ease-in-out"
      style={`height: ${fillPercentage}%;`}
    >
    </div>
  </div>

  <p class="text-heading-3 [writing-mode:vertical-rl]">{year}</p>

  <div class="ml-10">
    <p class="xl:text-subheading-1 text-[24px] font-normal">{subtitle}</p>
    <p
      class="text-heading-5 md:text-heading-4 xl:text-heading-3 mb-10 xl:mb-15"
    >
      {title}
    </p>

    <ul class="text-body list-disc space-y-4 pl-5">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</div>
