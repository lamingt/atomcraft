---
import { Image } from "astro:assets";
import Team from "../../assets/about/what.png";
---

<section class="w-full" id="what">
  <div
    class="relative z-10 flex flex-col items-center pt-[50px] pb-15 text-center sm:pt-[100px] md:pb-20 lg:block lg:pt-[150px] lg:text-left xl:pt-[250px] xl:pb-36"
  >
    <p
      id="question-text"
      class="text-pink text-body lg:text-subheading-1 mb-1 md:text-2xl"
    >
      What do we do?
    </p>
    <p
      id="answer-text"
      class="text-heading-5 md:text-heading-4 lg:text-heading-3 xl:text-heading-2 font-medium"
    >
      AtomCraft aims make the world&apos;s first tokamak entirely designed,
      built, and operated by undergraduate students within 2 years.
    </p>
  </div>
  <div
    class="flex w-full flex-col items-center gap-10 lg:flex-row lg:items-end xl:gap-30"
    id="what-2"
  >
    <div class="shrink-0 lg:w-1/2">
      <Image
        src={Team}
        alt="AtomCraft members standing behind models of the tokamak"
        class="h-auto w-full"
      />
    </div>

    <div class="lg:w-1/2">
      <p
        class="text-body md:text-heading-5 xl:text-heading-4 3xl:text-heading-3 text-center lg:text-start"
      >
        Students will develop innovative solutions to engineering challenges and
        work closely with industry partners, and push the boundaries of what is
        possible with fusion energy.
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const timeline = gsap.timeline({
    paused: true,
    scrollTrigger: {
      start: "top 80%",
      once: true,
      trigger: "#question-text",
      onEnter: () => timeline.play(),
    },
  });

  timeline.from("#question-text", {
    y: 50,
    opacity: 0,
    duration: 1.5,
    ease: "power3.out",
  });

  timeline.from(
    "#answer-text",
    {
      y: 50,
      opacity: 0,
      duration: 1.5,
      ease: "power3.out",
    },
    "<0.6",
  );

  gsap.from("#what-2", {
    y: 100,
    opacity: 0,
    duration: 1.0,
    ease: "power3.out",
    scrollTrigger: {
      trigger: "#what-2",
      start: "top 60%",
      once: true,
    },
  });
</script>
