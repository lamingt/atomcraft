---
import SecondaryOutline from "../buttons/SecondaryOutline.astro";
---

<section id="strategy" class="overflow-hidden">
  <h2
    class="gsap-heading text-heading-4 sm:text-heading-3 xl:text-heading-2 xs:mb-8 mb-4 opacity-0"
  >
    Our Strategy
  </h2>
  <p class="gsap-intro text-body xs:mb-32 mb-16 opacity-0">
    Our approach to achieving our mission considers all the different areas that
    fusion research impacts. This means connecting the research, education and
    the everyone else together and using them to inform our strategy.
  </p>
  <div
    class="text-body xs:gap-10 flex flex-col items-center gap-5 text-center lg:mx-23 2xl:mx-30"
  >
    <h4
      class="gsap-item text-heading-5 xs:text-heading-4 text-center opacity-0"
    >
      Technology & Innovation
    </h4>

    <div class="xs:flex-row xs:gap-23 flex flex-col items-center gap-10">
      <div
        class="gsap-item xs:w-1/2 flex flex-col items-center gap-5 opacity-0"
      >
        <SecondaryOutline> Learn by Building </SecondaryOutline>
        <p>
          Using machine design and construction as the central method for both
          learning and research
        </p>
      </div>
      <div
        class="gsap-item xs:w-1/2 flex flex-col items-center gap-5 opacity-0"
      >
        <SecondaryOutline> Iterate to innovate </SecondaryOutline>
        <p>
          Apply continuous feedback from experiments and prototypes to improve
          designs and processes.
        </p>
      </div>
    </div>

    <div class="gsap-plus text-heading-2 opacity-0">+</div>

    <h4
      class="gsap-item text-heading-5 xs:text-heading-4 text-center opacity-0"
    >
      Education & Academia
    </h4>

    <div class="xs:flex-row xs:gap-23 flex flex-col gap-10">
      <div
        class="gsap-item xs:w-1/2 flex flex-col items-center gap-5 opacity-0"
      >
        <SecondaryOutline> Empower students </SecondaryOutline>
        <p>
          Give students ownership of technical organisational and leadership
          responsibilities, supported by mentorship.
        </p>
      </div>
      <div
        class="gsap-item xs:w-1/2 flex flex-col items-center gap-5 opacity-0"
      >
        <SecondaryOutline> Bridge research and industry </SecondaryOutline>
        <p>
          Integrate academic expertise with industry standards to ensure
          relevance, rigor, and career pathways.
        </p>
      </div>
    </div>

    <div class="gsap-plus text-heading-2 opacity-0">+</div>

    <h4
      class="gsap-item text-heading-5 xs:text-heading-4 text-center opacity-0"
    >
      Public Engagement
    </h4>

    <div class="gsap-item xs:w-1/2 flex flex-col items-center gap-5 opacity-0">
      <SecondaryOutline> Communicate Fusion </SecondaryOutline>
      <p>
        Actively engage the public, partners, and policymakers to make fusion
        progress visible and inspiring
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // 1. Animate the main heading
    gsap.fromTo(
      ".gsap-heading",
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 1.5,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".gsap-heading",
          start: "top 70%",
          once: true,
        },
      },
    );

    // 2. Animate the intro paragraph
    gsap.fromTo(
      ".gsap-intro",
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 1.5,
        ease: "power3.out",
        delay: 0.1,
        scrollTrigger: {
          trigger: ".gsap-intro",
          start: "top 70%",
          once: true,
        },
      },
    );

    // 3. Animate the cards and plus signs independently based on scroll position
    const elements = gsap.utils.toArray(
      ".gsap-item, .gsap-plus",
    ) as HTMLElement[];

    elements.forEach((el) => {
      if (el.classList.contains("gsap-plus")) {
        // The dynamic "pop" for the plus signs
        gsap.fromTo(
          el,
          { scale: 0, rotation: -45, opacity: 0 },
          {
            scale: 1,
            rotation: 0,
            opacity: 1,
            duration: 1,
            ease: "back.out(1.7)",
            scrollTrigger: {
              trigger: el,
              start: "top 70%", // Triggers when this specific element enters the viewport
              once: true,
            },
          },
        );
      } else {
        // The standard slide-up for text blocks and cards
        gsap.fromTo(
          el,
          { y: 50, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 1,
            ease: "power2.out",
            scrollTrigger: {
              trigger: el,
              start: "top 70%",
              once: true,
            },
          },
        );
      }
    });
  });
</script>
