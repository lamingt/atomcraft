---
import PlanItem from "./PlanItem.astro";
---

<section id="plan" class="mb-50">
  <h2
    class="text-heading-4 sm:text-heading-3 xl:text-heading-2 mb-15 sm:mb-20 lg:mb-25"
  >
    Our Action Plan
  </h2>
  <div class="flex flex-col gap-15 sm:gap-20 md:mx-10 lg:gap-25">
    <PlanItem
      year="2024"
      subtitle="Year 1"
      title="Design Phase"
      fillPercentage={100}
      items={[
        "Complete full design of SOUTH device and its subsystems.",
        "Finalise engineering drawings, simulations, and component specifications.",
        "Plan safety frameworks, operational protocols, and team workflows.",
        "Establish core expert support for technical guidance.",
      ]}
    />
    <PlanItem
      year="2025"
      subtitle="Year 2"
      title="Iterative Construction and GDC Testing"
      fillPercentage={100}
      items={[
        "Construct and test the GDC (General Device Component) as a prototype platform.",
        "Refine assembly procedures and operational protocols based on testing outcomes.",
        "Train and onboard new team members, as team grows to 65 students.",
        "Begin preliminary experiments to validate subsystem designs.",
        "Formalise leadership roles, team structure, and cross-disciplinary training.",
      ]}
    />
    <PlanItem
      year="2026"
      subtitle="Year 3"
      title="Full Subsystems and Integration"
      fillPercentage={25}
      items={[
        "Complete construction and testing of all SOUTH subsystems: vacuum, magnets, RF heating, diagnostics.",
        "Integrate subsystems into a functional device and run initial plasma experiments.",
        "Continue performance logging and optimisation of operational procedures.",
      ]}
    />
    <PlanItem
      year="2027"
      subtitle="Year 4"
      title="Next-Generation Design and Research Projects"
      fillPercentage={0}
      items={[
        "Design and begin construction of SOUTH-2 (or next-generation device) using lessons from SOUTH-1.",
        "Launch collaborative student research projects with UNSW staff and external advisors.",
        "Host outreach events, workshops, and public demonstrations.",
        "Secure medium to long-term funding and institutional support.",
      ]}
    />
  </div>
</section>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  // gemini created this
  document.addEventListener("DOMContentLoaded", () => {
    // Grab all the PlanItem containers on the page
    const items = gsap.utils.toArray(".plan-item");

    items.forEach((item: any) => {
      // Find the specific internal elements for this single item
      const lineFill = item.querySelector(".plan-line-fill");
      const targetFill = lineFill.dataset.fill;
      const year = item.querySelector(".plan-year");
      const content = item.querySelector(".plan-content");

      // Create a timeline triggered by this specific item entering the viewport
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: item,
          start: "top 60%", // Triggers when the top of the item hits 80% down the screen
          once: true, // Only animate in once
        },
      });

      // 1. Fade and slide the whole container up
      tl.fromTo(
        item,
        { autoAlpha: 0, y: 50 },
        { autoAlpha: 1, y: 0, duration: 0.6, ease: "power2.out" },
      )
        // 2. Slide the year text down slightly
        .fromTo(
          year,
          { autoAlpha: 0, y: -20 },
          { autoAlpha: 1, y: 0, duration: 0.5, ease: "power2.out" },
          "-=0.4", // Overlap the animations slightly
        )
        // 3. Slide the text content in from the right
        .fromTo(
          content,
          { autoAlpha: 0, x: 30 },
          { autoAlpha: 1, x: 0, duration: 0.6, ease: "power2.out" },
          "-=0.4",
        )
        // 4. Finally, "grow" the progress line down to its target percentage
        .to(
          lineFill,
          { height: `${targetFill}%`, duration: 1.2, ease: "power3.out" },
          "-=0.2",
        );
    });
  });
</script>
