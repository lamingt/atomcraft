---
import { Image } from "astro:assets";

// interface Tag {
//   text: string;
//   bgColor: string;
// }

export interface Props {
  imageSrc: ImageMetadata;
  imageAlt: string;
  title: string;
  tags: string[];
  date: string;
  description: string;
  url: string;
}

const { imageSrc, imageAlt, title, date, tags, description, url } = Astro.props;
---

<a href={url} target="_blank" class="regular-news">
  <div class="flex w-[270px] xs:w-[400px] flex-col items-start gap-3 md:gap-5 group">
    <Image
      src={imageSrc}
      alt={imageAlt}
      class="h-[200px] w-full object-cover"
    />
    <div class="flex w-full justify-between">
      {
        tags.map((tag) => (
          <div class:list={["px-2 text-sm md:px-4 text-center rounded-2xl flex justify-center items-center ",  tag === "News" ? "bg-red" : "bg-pink" ]}>
            {tag}
          </div>
        ))
      }
      <p class="text-[#AAAAAA]">{date}</p>
    </div>

    <div>
      <p class="text-xl font-medium md:text-heading-5 group-hover:underline">{title}</p>
    </div>
    <p class="text-gray_text text-[13px] leading-[140%]">
      {description}
    </p>

  </div>
</a>
