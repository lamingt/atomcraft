---
import { Image } from "astro:assets";

// interface Tag {
//   text: string;
//   bgColor: string;
// }

export interface Props {
  imageSrc: ImageMetadata;
  imageAlt: string;
  title: string;
  tags: string[];
  date: string;
  description: string;
  url: string;
}

const { imageSrc, imageAlt, title, date, tags, description, url } = Astro.props;
---

<a href={url} target="_blank" class="regular-news">
  <div
    class="xs:w-[400px] group flex w-[270px] flex-col items-start gap-3 md:gap-5"
  >
    <div class="relative h-[200px] w-full">
      <Image
        src={imageSrc}
        alt={imageAlt}
        class="absolute inset-0 h-full w-full rounded-[10px] object-cover"
      />
      <div class="absolute inset-0 rounded-[10px] bg-black/10 transition-colors duration-300 group-hover:bg-transparent"></div>
    </div>
    <div class="flex w-full justify-between">
      {
        tags.map((tag) => (
          <div
            class:list={[
              "flex items-center justify-center rounded-2xl px-2 text-center text-sm md:px-4",
              tag === "News" ? "bg-red" : "bg-pink",
            ]}
          >
            {tag}
          </div>
        ))
      }
      <p class="text-[#AAAAAA]">{date}</p>
    </div>

    <div>
      <p class="md:text-heading-5 text-xl font-medium group-hover:underline line-clamp-1">
        {title}
      </p>
    </div>
    <p class="text-gray_text text-[13px] leading-[140%] line-clamp-2 group-hover:underline">
      {description}
    </p>
  </div>
</a>
