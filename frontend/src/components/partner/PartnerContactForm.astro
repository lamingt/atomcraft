---
import SecondaryButton from "../buttons/SecondaryButton.astro";
---

<div class="bg-very-dark-purple rounded-[24px] p-8 md:p-12 shadow-2xl w-full">
  <p class="text-white text-base md:text-subheading-3 mb-2 font-medium tracking-wide">Want to know more?</p>
  <h2 class="text-white text-3xl md:text-heading-4 leading-tight font-semibold mb-8">Send us a quick message</h2>
  
  <form
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    method="POST"
    name="contact"
    class="flex flex-col gap-4"
  >
    <p class="hidden">
      <label>Don't fill this out if you're human: <input name="bot-field" /></label>
    </p>
    <input type="hidden" name="form-name" value="contact" />
    
    <input
      type="text"
      name="name"
      placeholder="Name"
      class="w-full bg-[#080310] text-light-purple placeholder:text-light-purple rounded-[12px] px-5 py-4 focus:outline-none focus:ring-1 focus:ring-purple transition-shadow"
      required
    />
    
    <input
      type="email"
      name="email"
      placeholder="Email address"
      class="w-full bg-[#080310] text-light-purple placeholder:text-light-purple rounded-[12px] px-5 py-4 focus:outline-none focus:ring-1 focus:ring-purple transition-shadow"
      required
    />
    
    <textarea
      name="message"
      placeholder="Message"
      rows="6"
      class="w-full bg-[#080310] text-light-purple placeholder:text-light-purple rounded-[12px] px-5 py-4 resize-none focus:outline-none focus:ring-1 focus:ring-purple transition-shadow"
      required
    ></textarea>
    
    <div class="flex justify-end mt-4">
      <SecondaryButton type="submit">
        Send Message
      </SecondaryButton>
    </div>
  </form>
</div>
