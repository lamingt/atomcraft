---
import { Image } from "astro:assets";

// Import all images in the partner directory
const images = import.meta.glob<{ default: ImageMetadata }>("../../assets/partner/*.{jpeg,jpg,png,svg,gif}");

// Filter out csiro image keys
const imageKeys = Object.keys(images).filter(key => !key.includes('csiro'));

// Load all image metadata
const loadedImages = await Promise.all(
  imageKeys.map(async (key) => {
    return (await images[key]()).default;
  })
);
---

<section class="w-screen bg-white py-12 md:py-20 relative left-1/2 -translate-x-1/2 mt-32">
  <div class="mx-auto flex w-full max-w-[1500px] flex-wrap items-center justify-center gap-x-10 gap-y-4 px-6 md:gap-16 lg:gap-24">
    {loadedImages.map((logo, index) => (
      <div class="flex h-20 w-32 items-center justify-center transition-transform duration-300 hover:scale-105 md:h-28 md:w-48 lg:h-32 lg:w-56">
        <Image
          src={logo}
          alt={`Partner logo ${index + 1}`}
          class="h-full w-full object-contain mix-blend-multiply"
        />
      </div>
    ))}
  </div>
</section>