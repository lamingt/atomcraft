---
import { Image } from "astro:assets";
import TertiaryOutlineButton from "../../components/buttons/TertiaryOutlineButton.astro";
import partnerImage from "../../assets/partner/csiro.jpeg";
---

<section>
  <div
    class="mx-auto mt-[100px] w-[90%] max-w-[1500px] lg:mt-[150px] 2xl:mt-[250px]"
  >
    <div
      class="flex flex-col gap-10 lg:flex-row lg:items-stretch xl:gap-[70px]"
    >
      <div class="flex flex-col items-start lg:w-[45%]">
        <div>
          <h1
            class="xl:text-heading-2 3xl:font-bold mb-5 w-fit text-4xl md:text-5xl"
          >
            <span class="gradient-text">Partner</span>
            <br />
            with Atomcraft
          </h1>
          <p class="text-gray_text 3xl:text-lg mb-10 w-full lg:mb-0">
            Our partners provide the support and resources that make our
            research and engineering work possible, enabling us to turn
            ambitious ideas into real-world fusion devices.
          </p>
        </div>

        <div class="mt-auto w-full lg:pt-6">
          <TertiaryOutlineButton href="#partner-form">
            Contact Us
          </TertiaryOutlineButton>
        </div>
      </div>

      <div class="min-w-0 flex-1">
        <Image
          src={partnerImage}
          alt="AtomCraft members with arms around each other's shoulders in front of a screen which reads 'Empowering Excellence Breakfast'"
          class="aspect-3/2 h-full w-full rounded-[10px] object-cover"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
