---
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import SecondaryButton from "./buttons/SecondaryButton.astro";
import PrimaryButton from "./buttons/PrimaryButton.astro";

const isHome = Astro.url.pathname === "/";
---

<header
  class:list={[
    "bg-dark-purple fixed top-0 left-0 z-100 flex h-20 w-full items-center lg:h-26",
    { invisible: isHome },
  ]}
  id="navbar"
>
  <!-- <div
    class="absolute top-0 left-1/2 z-5 h-20 sm:h-30 w-full -translate-x-1/2 bg-[linear-gradient(to_bottom,rgba(41,14,101,1)_0%,rgba(41,14,101,0.8)_50%,transparent_100%)]
    blur-2xl lg:h-25 xl:h-30 2xl:h-40"
  >
  </div> -->
  <!-- <div
    class="absolute top-0 left-1/2 z-[-5] h-30 w-full -translate-x-1/2 bg-gradient-to-b from-[rgba(41,14,101,0.7)] to-[rgba(8,4,17,0)]"
  >
  </div> -->

  <div
    class="relative z-10 mx-5 flex w-full items-center justify-between lg:mx-[30px] xl:mx-10"
  >
    <div
      class="md:text-md  xl:text-lg flex items-center md:gap-5 lg:gap-10 xl:gap-[60px]"
    >
      <a href="/">
        <Image
          src={logo}
          alt="logo"
          loading="eager"
          class="z-10 w-[200px] sm:w-[175px] lg:w-52"
        />
      </a>
      <div class="lg:flex hidden gap-5 lg:gap-5 2xl:gap-10">
        <a href="/about" class="hover:underline"> About Us </a>
        <a href="/news" class="hover:underline"> News </a>
        <a href="/members" class="hover:underline"> Members </a>
        <a href="/partners" class="hover:underline"> Partners </a>
        <!-- <a href="/join" class="hover:underline"> Recruitment </a> -->
      </div>
    </div>

    <div class="z-10 hidden lg:block">
      <div class="flex items-center gap-3 xl:gap-[30px]">
        <SecondaryButton href="/partners" class="md:text-sm lg:text-[16px]">
          Partner With Us
        </SecondaryButton>
        <PrimaryButton target="_blank" href="https://www.unsw.edu.au/challeng/vertically-integrated-projects/explore-vertically-integrated-projects/atomcraft" class="md:text-sm lg:text-[16px]">
          Join Our Team
        </PrimaryButton>
      </div>
    </div>

    <div class="z-10 flex flex-col items-center pr-2 lg:hidden">
      <button
        id="mobile-menu-btn"
        class="group lg:hidden inline-flex h-12 w-12 cursor-pointer items-center justify-center rounded text-center text-white shadow-[0_1px_0_theme(colors.slate.950/.04),0_1px_2px_theme(colors.slate.950/.12),inset_0_-2px_0_theme(colors.slate.950/.04)] transition hover:shadow-[0_1px_0_theme(colors.slate.950/.04),0_4px_8px_theme(colors.slate.950/.12),inset_0_-2px_0_theme(colors.slate.950/.04)]"
        aria-pressed="false"
      >
        <span class="sr-only">Menu</span>
        <svg
          class="pointer-events-none h-6 w-6 fill-current"
          viewBox="0 0 16 16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            class="origin-center translate-x-[7px] -translate-y-[5px] transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.1)] group-[[aria-pressed=true]]:translate-x-0 group-[[aria-pressed=true]]:translate-y-0 group-[[aria-pressed=true]]:rotate-[315deg]"
            y="7"
            width="9"
            height="2"
            rx="1"></rect>
          <rect
            class="origin-center transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.8)] group-[[aria-pressed=true]]:rotate-45"
            y="7"
            width="16"
            height="2"
            rx="1"></rect>
          <rect
            class="origin-center translate-y-[5px] transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.1)] group-[[aria-pressed=true]]:translate-y-0 group-[[aria-pressed=true]]:rotate-[135deg]"
            y="7"
            width="9"
            height="2"
            rx="1"></rect>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden invisible absolute top-full left-0 w-full overflow-hidden opacity-0 transition-all duration-300 ease-in-out bg-dark-purple/95 backdrop-blur-md shadow-2xl max-h-0 border-t border-white/10"
  >
    <div class="flex flex-col w-full">
      <a href="/about" class="px-6 py-4 text-center text-white border-b border-white/10 hover:underline"> About Us </a>
      <a href="/news" class="px-6 py-4 text-center text-white border-b border-white/10 hover:underline"> News </a>
      <a href="/members" class="px-6 py-4 text-center text-white border-b border-white/10 hover:underline"> Members </a>
      <a href="/partners" class="px-6 py-4 text-center text-white border-b border-white/10 hover:underline"> Partner </a>
      <a target="_blank" href="https://www.unsw.edu.au/challeng/vertically-integrated-projects/explore-vertically-integrated-projects/atomcraft" class="px-6 py-4 text-center text-white hover:underline"> Join Us </a>
    </div>
  </div>
</header>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // Mobile menu logic
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener("click", () => {
        const isPressed = menuBtn.getAttribute("aria-pressed") === "true";
        menuBtn.setAttribute("aria-pressed", String(!isPressed));

        mobileMenu.classList.toggle("opacity-0");
        mobileMenu.classList.toggle("invisible");
        mobileMenu.classList.toggle("max-h-0");
        mobileMenu.classList.toggle("max-h-screen");
      });
    }

    // --- ANIMATION LOGIC ---

    // 1. Define the SCROLL Animation (Fast)
    const scrollAnim = gsap
      .from("#navbar", {
        yPercent: -100,
        paused: true,
        duration: 0.2,
        ease: "power2.out",
      })
      .progress(1);

    const isHome = window.location.pathname === "/";

    if (isHome) {
      // 2. Run the INTRO Animation (Slow) ONLY on Home Page
      gsap.fromTo(
        "#navbar",
        {
          yPercent: -100,
          autoAlpha: 0, // Starts invisible
        },
        {
          yPercent: 0,
          autoAlpha: 1, // Becomes visible
          duration: 1.5, // Slow duration for the initial drop
          delay: 1.6,
          ease: "power4.out",
          onComplete: () => {
            initScrollTrigger();
          },
        },
      );
    } else {
      // On other pages, ensure it's visible and init scroll trigger immediately
      gsap.set("#navbar", { yPercent: 0, autoAlpha: 1 });
      initScrollTrigger();
    }

    function initScrollTrigger() {
      ScrollTrigger.create({
        start: "top top",
        end: "max",
        onUpdate: (self) => {
          self.direction === -1 ? scrollAnim.play() : scrollAnim.reverse();
        },
      });
    }
  });
</script>
