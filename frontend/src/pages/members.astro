---
import MembersLayout from "../layouts/MembersLayout.astro";

import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import TeamSection from "../components/members/TeamSection.astro";
import "@fontsource/inter/500.css";
import "@fontsource/inter/800.css";

const teams = await getCollection("teams");
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/notion-images/members/*.{jpeg,jpg,png,svg,webp}",
);
const imageLookup: Record<string, ImageMetadata> = {};

for (const path in images) {
  const file = path.split("/").pop()!;
  const base = file.replace(/\.(jpg|jpeg|png|svg|webp)$/i, "");
  imageLookup[base] = (await images[path]()).default;
}
---

<MembersLayout>
  <div
    class="mx-auto mt-[150px] mb-20 w-[90%] max-w-[1500px] lg:mb-31 2xl:mt-[250px]"
  >
    <div class="items-left flex w-full flex-col">
      <h1
        class="sm:text-heading-3 md:text-heading-2 xl:text-heading-1 mb-20 text-left text-[clamp(26px,7vw,40px)] leading-[125%] font-bold whitespace-nowrap md:mb-30 lg:mb-40 xl:mb-51"
      >
        Meet our team <br /> of Creators, Engineers, <br /> and Visionaries.
      </h1>
      <div class="flex flex-col gap-20 md:gap-30 lg:gap-40">
        {
          teams.map(({ data }) => (
            <TeamSection
              teamName={data.name}
              description={data.description}
              members={data.members}
              memberImageLookup={imageLookup}
            />
          ))
        }
      </div>
    </div>
  </div>
</MembersLayout>
