---
import { Image } from "astro:assets";
import PartnersLayout from "../layouts/PartnersLayout.astro";
import "../styles/global.css";
import email from "../assets/email.svg";
import PartnerHero from "../components/partner/PartnerHero.astro";
import PartnerCarousel from "../components/PartnerCarousel.astro";
import PartnerList from "../components/partner/PartnerList.astro";
import ObjectivesAndStrategy from "../components/partner/ObjectivesAndStrategy.astro";
import PartnerContactForm from "../components/partner/PartnerContactForm.astro";

export const prerender = true;
---

<PartnersLayout>
  <div class="relative mx-auto max-w-[1920px] flex-col items-center px-6 md:px-[120px]">
    <PartnerHero />
    <PartnerCarousel />
    <PartnerList/>
    <ObjectivesAndStrategy/>

    <div
      class="mx-auto mt-[20vh] flex w-fit flex-col justify-center gap-[5vw] lg:flex-row" id="partner-form"
    >
      <div class="text-gray_text flex w-full flex-col lg:w-[30%]">
        <h2 class="mb-5 text-3xl text-white xl:text-5xl">
          We'd love to hear from you!
        </h2>
        <p class="mb-2 w-full text-xl lg:w-full">
          Whether you're curious about what we do or want to get involved, we'd
          love to chat.
        </p>
        <div class="flex">
          <Image src={email} alt="email svg" class="mr-2" loading="eager" />
          <p>atomcraft@unsw.edu.au</p>
        </div>
      </div>
      <div class="mb-32 w-full md:w-2xl mx-auto lg:mx-0">
        <PartnerContactForm />
      </div>
    </div>
  </div>
</PartnersLayout>
